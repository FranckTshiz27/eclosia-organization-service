<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="eleves_eclosia"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="SCHOOL_NAME" class="java.lang.String"/>
    <parameter name="SCHOOL_ADDRESS" class="java.lang.String"/>
    <parameter name="SCHOOL_CONTACT" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR_LABEL" class="java.lang.String"/>
    <parameter name="PRINT_DATE" class="java.lang.String"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="classroomName" class="java.lang.String"/>
    <field name="photoPath" class="java.lang.String"/>
    <field name="studentNumber" class="java.lang.String"/>
    <field name="fullName" class="java.lang.String"/>
    <field name="gender" class="java.lang.String"/>
    <field name="birthDate" class="java.lang.String"/>
    <field name="birthPlace" class="java.lang.String"/>
    <field name="tutorName" class="java.lang.String"/>
    <field name="phoneNumber" class="java.lang.String"/>

    <variable name="ROW_IN_CLASS" class="java.lang.Integer" resetType="Group" resetGroup="ClassroomGroup" calculation="Count">
        <variableExpression><![CDATA[$F{studentNumber}]]></variableExpression>
    </variable>

    <group name="ClassroomGroup">
        <groupExpression><![CDATA[$F{classroomName}]]></groupExpression>
        <groupHeader>
            <band height="26">
                <rectangle>
                    <reportElement x="0" y="2" width="802" height="22"/>
                    <graphicElement>
                        <pen lineWidth="0.6"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="8" y="5" width="786" height="16"/>
                    <textElement verticalAlignment="Middle">
                        <font size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Classe : " + $F{classroomName}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="80">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="75"/>
                <graphicElement>
                    <pen lineWidth="0.6"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="10" y="8" width="500" height="18"/>
                <textElement>
                    <font size="15" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="10" y="28" width="500" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="10" y="44" width="500" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_CONTACT}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="520" y="8" width="272" height="20"/>
                <textElement textAlignment="Right">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTE DES ELEVES PAR CLASSE]]></text>
            </staticText>
            <textField>
                <reportElement x="520" y="30" width="272" height="14"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Annee scolaire : " + $P{ACADEMIC_YEAR_LABEL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="520" y="48" width="272" height="14"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Date d'impression : " + $P{PRINT_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="24" forecolor="#FFFFFF" backcolor="#0B2F6B"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="4" width="35" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[N°]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="4" width="50" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[PHOTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="85" y="4" width="95" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[MATRICULE]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="4" width="165" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[NOM & PRENOM]]></text>
            </staticText>
            <staticText>
                <reportElement x="345" y="4" width="40" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[SEXE]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="4" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[DATE NAISSANCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="485" y="4" width="110" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[LIEU NAISSANCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="595" y="4" width="125" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TUTEUR]]></text>
            </staticText>
            <staticText>
                <reportElement x="720" y="4" width="82" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TELEPHONE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <line><reportElement x="0" y="23" width="802" height="1"/></line>

            <textField>
                <reportElement x="0" y="4" width="35" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$V{ROW_IN_CLASS}]]></textFieldExpression>
            </textField>

            <image scaleImage="FillFrame" onErrorType="Blank">
                <reportElement x="38" y="2" width="44" height="20"/>
                <imageExpression><![CDATA[$F{photoPath} == null ? null : new java.io.File($F{photoPath})]]></imageExpression>
            </image>

            <textField>
                <reportElement x="85" y="4" width="95" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{studentNumber}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="180" y="4" width="165" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{fullName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="345" y="4" width="40" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{gender}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="385" y="4" width="100" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{birthDate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="485" y="4" width="110" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{birthPlace}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="595" y="4" width="125" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{tutorName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="720" y="4" width="82" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{phoneNumber} == null ? "-" : $F{phoneNumber}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="640" y="2" width="162" height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="35">
            <line><reportElement x="0" y="0" width="802" height="1"/></line>
            <textField>
                <reportElement x="0" y="10" width="500" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Effectif total : " + String.valueOf($V{REPORT_COUNT}) + " eleves"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>

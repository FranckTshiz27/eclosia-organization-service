<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="eleves_eclosia"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="SCHOOL_NAME" class="java.lang.String"/>
    <parameter name="SCHOOL_ADDRESS" class="java.lang.String"/>
    <parameter name="SCHOOL_CONTACT" class="java.lang.String"/>
    <parameter name="SCHOOL_LOGO_PATH" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR_LABEL" class="java.lang.String"/>
    <parameter name="PRINT_DATE" class="java.lang.String"/>
    <parameter name="PRINT_TIME" class="java.lang.String"/>
    <parameter name="CLASS_LABEL" class="java.lang.String"/>
    <parameter name="TOTAL_STUDENTS" class="java.lang.Integer"/>
    <parameter name="TOTAL_BOYS" class="java.lang.Long"/>
    <parameter name="TOTAL_GIRLS" class="java.lang.Long"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="classroomName" class="java.lang.String"/>
    <field name="photoPath" class="java.lang.String"/>
    <field name="studentNumber" class="java.lang.String"/>
    <field name="fullName" class="java.lang.String"/>
    <field name="gender" class="java.lang.String"/>
    <field name="birthDate" class="java.lang.String"/>
    <field name="birthPlace" class="java.lang.String"/>
    <field name="tutorName" class="java.lang.String"/>
    <field name="phoneNumber" class="java.lang.String"/>

    <variable name="ROW_IN_CLASS" class="java.lang.Integer" resetType="Group" resetGroup="ClassroomGroup" calculation="Count">
        <variableExpression><![CDATA[$F{studentNumber}]]></variableExpression>
    </variable>

    <group name="ClassroomGroup">
        <groupExpression><![CDATA[$F{classroomName}]]></groupExpression>
        <groupHeader>
            <band height="26">
                <rectangle>
                    <reportElement x="0" y="2" width="802" height="22" backcolor="#E9EDF6" mode="Opaque"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#C7D1E5"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="10" y="6" width="784" height="14" forecolor="#1B2D5B"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Classe : " + $F{classroomName}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="108">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="98"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#D0D0D0"/>
                </graphicElement>
            </rectangle>

            <image onErrorType="Blank" scaleImage="RetainShape">
                <reportElement x="8" y="8" width="80" height="60"/>
                <imageExpression><![CDATA[$P{SCHOOL_LOGO_PATH} == null || $P{SCHOOL_LOGO_PATH}.trim().isEmpty() ? null : new java.io.File($P{SCHOOL_LOGO_PATH})]]></imageExpression>
            </image>

            <textField>
                <reportElement x="98" y="8" width="250" height="22" forecolor="#102A59"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="98" y="32" width="250" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="98" y="48" width="250" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_CONTACT}]]></textFieldExpression>
            </textField>

            <line><reportElement x="355" y="8" width="1" height="78"/></line>
            <line><reportElement x="605" y="8" width="1" height="78"/></line>

            <staticText>
                <reportElement x="372" y="13" width="220" height="24" forecolor="#102A59"/>
                <textElement textAlignment="Center"><font size="15" isBold="true"/></textElement>
                <text><![CDATA[LISTE DES ELEVES PAR CLASSE]]></text>
            </staticText>
            <textField>
                <reportElement x="372" y="45" width="220" height="15"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Annee scolaire : " + $P{ACADEMIC_YEAR_LABEL}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="620" y="16" width="170" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Date d'impression : " + $P{PRINT_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="620" y="32" width="170" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Heure d'impression : " + $P{PRINT_TIME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="620" y="48" width="170" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Classe : " + $P{CLASS_LABEL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="620" y="64" width="170" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Effectif : " + String.valueOf($P{TOTAL_STUDENTS}) + "  |  G: " + String.valueOf($P{TOTAL_BOYS}) + "  F: " + String.valueOf($P{TOTAL_GIRLS})]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="97" width="802" height="1" forecolor="#132C59"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="24" backcolor="#0B2F6B" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="4" width="35" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[N°]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="4" width="50" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[PHOTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="85" y="4" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[MATRICULE]]></text>
            </staticText>
            <staticText>
                <reportElement x="185" y="4" width="170" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[NOM & PRENOM]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="4" width="45" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[SEXE]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="4" width="115" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[DATE NAISSANCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="515" y="4" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[LIEU NAISSANCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="615" y="4" width="105" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TUTEUR]]></text>
            </staticText>
            <staticText>
                <reportElement x="720" y="4" width="82" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TELEPHONE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.2" lineColor="#D5DBE6"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="0" y="4" width="35" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$V{ROW_IN_CLASS}]]></textFieldExpression>
            </textField>

            <image scaleImage="FillFrame" onErrorType="Blank">
                <reportElement x="38" y="2" width="44" height="20"/>
                <imageExpression><![CDATA[$F{photoPath} == null ? null : new java.io.File($F{photoPath})]]></imageExpression>
            </image>

            <textField>
                <reportElement x="85" y="4" width="100" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{studentNumber}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="185" y="4" width="170" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{fullName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="355" y="4" width="45" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{gender}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="4" width="115" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{birthDate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="515" y="4" width="100" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{birthPlace}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="615" y="4" width="105" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{tutorName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="720" y="4" width="82" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{phoneNumber} == null ? "-" : $F{phoneNumber}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="660" y="2" width="142" height="14"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="70">
            <line><reportElement x="0" y="0" width="802" height="1"/></line>
            <textField>
                <reportElement x="8" y="8" width="380" height="16"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Effectif total : " + String.valueOf($P{TOTAL_STUDENTS}) + " eleves"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="135" y="34" width="140" height="13"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Le Titulaire de la Classe]]></text>
            </staticText>
            <staticText>
                <reportElement x="342" y="34" width="140" height="13"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Le Prefet des Etudes]]></text>
            </staticText>
            <staticText>
                <reportElement x="549" y="34" width="140" height="13"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Le Directeur]]></text>
            </staticText>
            <line><reportElement x="145" y="58" width="120" height="1"/></line>
            <line><reportElement x="352" y="58" width="120" height="1"/></line>
            <line><reportElement x="559" y="58" width="120" height="1"/></line>
        </band>
    </summary>
</jasperReport>

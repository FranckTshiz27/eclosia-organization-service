                </staticText>
                <textField>
                    <reportElement x="314" y="51" width="188" height="7" style="Tiny"/>
                    <textFieldExpression><![CDATA[$F{enrollmentNumber}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="69" y="60" width="433" height="8" style="SubTitle"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[($F{bulletinTitle} == null || $F{bulletinTitle}.isEmpty()
                            ? "BULLETIN DE L'ELEVE"
                            : $F{bulletinTitle})
                            + "          ANNEE SCOLAIRE  "
                            + $F{academicYearLabel}]]></textFieldExpression>
                </textField>


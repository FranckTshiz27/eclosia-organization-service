<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portrait A4 — 1 élève = 1 page.
  Grille : BRANCHES | MAX | T1(6) | T2(6) | T3(6) | TOTAL(2)
  Largeurs : 80 + 16 + 18*18 + 2*24 = 468 ; étendu à ~555
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bulletin_eleve"
              pageWidth="595"
              pageHeight="842"
              orientation="Portrait"
              columnWidth="571"
              leftMargin="12"
              rightMargin="12"
              topMargin="12"
              bottomMargin="12"
              whenNoDataType="AllSectionsNoDetail">

    <property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true"/>

    <style name="Default" fontName="DejaVu Sans" fontSize="5" isDefault="true"/>
    <style name="Title" fontName="DejaVu Sans" fontSize="7" isBold="true"/>
    <style name="SubTitle" fontName="DejaVu Sans" fontSize="5" isBold="true"/>
    <style name="Tiny" fontName="DejaVu Sans" fontSize="4"/>
    <style name="TinyBold" fontName="DejaVu Sans" fontSize="4" isBold="true"/>
    <style name="Cell" fontName="DejaVu Sans" fontSize="4" hTextAlign="Center" vTextAlign="Middle" mode="Opaque">
        <box>
            <pen lineWidth="0.4" lineColor="#000000"/>
            <topPen lineWidth="0.4" lineColor="#000000"/>
            <leftPen lineWidth="0.4" lineColor="#000000"/>
            <bottomPen lineWidth="0.4" lineColor="#000000"/>
            <rightPen lineWidth="0.4" lineColor="#000000"/>
        </box>
    </style>
    <style name="Branch" fontName="DejaVu Sans" fontSize="4" hTextAlign="Left" vTextAlign="Middle" mode="Opaque">
        <box>
            <pen lineWidth="0.4" lineColor="#000000"/>
            <topPen lineWidth="0.4" lineColor="#000000"/>
            <leftPen lineWidth="0.4" lineColor="#000000"/>
            <bottomPen lineWidth="0.4" lineColor="#000000"/>
            <rightPen lineWidth="0.4" lineColor="#000000"/>
        </box>
    </style>
    <style name="SubjectGroup" fontName="DejaVu Sans" fontSize="4" isBold="true" isItalic="true" hTextAlign="Left" vTextAlign="Middle" mode="Opaque" backcolor="#F5F5F5">
        <box>
            <pen lineWidth="0.25" lineColor="#000000"/>
            <topPen lineWidth="0.25" lineColor="#000000"/>
            <leftPen lineWidth="0.25" lineColor="#000000"/>
            <bottomPen lineWidth="0.25" lineColor="#000000"/>
            <rightPen lineWidth="0.25" lineColor="#000000"/>
        </box>
    </style>
    <style name="DomainBanner" fontName="DejaVu Sans" fontSize="4" isBold="true" hTextAlign="Center" vTextAlign="Middle" mode="Opaque" forecolor="#FFFFFF" backcolor="#4A4A4A">
        <box>
            <pen lineWidth="0.25" lineColor="#000000"/>
            <topPen lineWidth="0.25" lineColor="#000000"/>
            <leftPen lineWidth="0.25" lineColor="#000000"/>
            <bottomPen lineWidth="0.25" lineColor="#000000"/>
            <rightPen lineWidth="0.25" lineColor="#000000"/>
        </box>
    </style>
    <style name="HeaderCell" fontName="DejaVu Sans" fontSize="3" isBold="true" hTextAlign="Center" vTextAlign="Middle" mode="Opaque">
        <box>
            <pen lineWidth="0.45" lineColor="#000000"/>
            <topPen lineWidth="0.45" lineColor="#000000"/>
            <leftPen lineWidth="0.45" lineColor="#000000"/>
            <bottomPen lineWidth="0.45" lineColor="#000000"/>
            <rightPen lineWidth="0.45" lineColor="#000000"/>
        </box>
    </style>
    <style name="FooterCell" fontName="DejaVu Sans" fontSize="3" hTextAlign="Left" vTextAlign="Middle" mode="Opaque">
        <box>
            <pen lineWidth="0.25" lineColor="#000000"/>
            <topPen lineWidth="0.25" lineColor="#000000"/>
            <leftPen lineWidth="0.25" lineColor="#000000"/>
            <bottomPen lineWidth="0.25" lineColor="#000000"/>
            <rightPen lineWidth="0.25" lineColor="#000000"/>
        </box>
    </style>

    <parameter name="INCLUDE_COVER_PAGE" class="java.lang.Boolean"/>
    <parameter name="COVER_TITLE" class="java.lang.String"/>
    <parameter name="COVER_SUBTITLE" class="java.lang.String"/>
    <parameter name="FLAG_IMAGE" class="java.lang.Object"/>

    <!-- isStartNewPage : 1 élève = 1 page ; keepTogether=false pour éviter page blanche si dense -->
    <group name="StudentGroup" isStartNewPage="true" keepTogether="false">
        <groupExpression><![CDATA[$F{studentEnrollmentId}]]></groupExpression>
        <groupHeader>
            <band height="96">
                <image onErrorType="Blank" scaleImage="RetainShape">
                    <reportElement x="69" y="0" width="36" height="24"/>
                    <imageExpression><![CDATA[$P{FLAG_IMAGE}]]></imageExpression>
                </image>
                <image onErrorType="Blank" scaleImage="RetainShape">
                    <reportElement x="474" y="0" width="28" height="28"/>
                    <imageExpression><![CDATA[$P{ARMS_IMAGE}]]></imageExpression>
                </image>

                <staticText>
                    <reportElement x="69" y="0" width="433" height="9" style="Title"/>
                    <textElement textAlignment="Center"/>
                    <text><![CDATA[REPUBLIQUE DEMOCRATIQUE DU CONGO]]></text>
                </staticText>
                <staticText>
                    <reportElement x="69" y="9" width="433" height="7" style="SubTitle"/>
                    <textElement textAlignment="Center"/>
                    <text><![CDATA[MINISTERE DE L'EDUCATION NATIONALE ET NOUVELLE CITOYENNETE]]></text>
                </staticText>

                <staticText>
                    <reportElement x="69" y="30" width="28" height="7" style="TinyBold"/>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="configured_fees"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="12"
              bottomMargin="12"
              whenNoDataType="AllSectionsNoDetail">

    <style name="HeaderTitle" fontName="DejaVu Sans" fontSize="15" isBold="true" forecolor="#0B2447"/>
    <style name="HeaderSub" fontName="DejaVu Sans" fontSize="9" forecolor="#1A56A8"/>
    <style name="HeaderMeta" fontName="DejaVu Sans" fontSize="8" forecolor="#4A5568"/>
    <style name="FilterLabel" fontName="DejaVu Sans" fontSize="7" forecolor="#5F6B7A"/>
    <style name="FilterValue" fontName="DejaVu Sans" fontSize="7" isBold="true" forecolor="#0B2447"/>
    <style name="GroupCategory" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#0B2447"/>
    <style name="GroupCycle" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#1B5E20"/>
    <style name="GroupTranche" fontName="DejaVu Sans" fontSize="7" isBold="true" forecolor="#5D4037"/>
    <style name="TableHeader" fontName="DejaVu Sans" fontSize="7" isBold="true" forecolor="#FFFFFF"/>
    <style name="TableCell" fontName="DejaVu Sans" fontSize="7" forecolor="#243447"/>
    <style name="KpiLabel" fontName="DejaVu Sans" fontSize="7" forecolor="#5F6B7A"/>
    <style name="KpiValue" fontName="DejaVu Sans" fontSize="11" isBold="true" forecolor="#0B2447"/>
    <style name="GrandTotal" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#0B2447"/>

    <parameter name="LOGO_IMAGE" class="java.lang.Object"/>
    <parameter name="SCHOOL_NAME" class="java.lang.String"/>
    <parameter name="SCHOOL_ADDRESS" class="java.lang.String"/>
    <parameter name="SCHOOL_PHONE" class="java.lang.String"/>
    <parameter name="SCHOOL_EMAIL" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR_LABEL" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="CYCLE_FILTER_LABEL" class="java.lang.String"/>
    <parameter name="CLASS_FILTER_LABEL" class="java.lang.String"/>
    <parameter name="PAYMENT_MODE_FILTER_LABEL" class="java.lang.String"/>
    <parameter name="CURRENCY_FILTER_LABEL" class="java.lang.String"/>
    <parameter name="REFERENCE_CURRENCY_CODE" class="java.lang.String"/>
    <parameter name="PRINT_DATETIME" class="java.lang.String"/>
    <parameter name="TOTAL_FEES_COUNT" class="java.lang.Integer"/>
    <parameter name="TOTAL_ANNUAL_AMOUNT_LABEL" class="java.lang.String"/>
    <parameter name="TOTAL_INSTALLMENTS_COUNT" class="java.lang.Integer"/>
    <parameter name="TOTAL_CATEGORIES_COUNT" class="java.lang.Integer"/>
    <parameter name="CURRENCY_NOTE" class="java.lang.String"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="code" class="java.lang.String"/>
    <field name="feeName" class="java.lang.String"/>
    <field name="feeCategoryName" class="java.lang.String"/>
    <field name="applicableToLabel" class="java.lang.String"/>
    <field name="annualAmountLabel" class="java.lang.String"/>
    <field name="installmentCount" class="java.lang.Integer"/>
    <field name="periodicityLabel" class="java.lang.String"/>
    <field name="calculationModeLabel" class="java.lang.String"/>
    <field name="statusLabel" class="java.lang.String"/>
    <field name="active" class="java.lang.Boolean"/>
    <field name="cycleName" class="java.lang.String"/>
    <field name="cycleDisplayOrder" class="java.lang.Integer"/>
    <field name="installmentName" class="java.lang.String"/>
    <field name="installmentDisplayOrder" class="java.lang.Integer"/>
    <field name="categoryFeeCount" class="java.lang.Integer"/>
    <field name="categoryTotalAmountLabel" class="java.lang.String"/>
    <field name="categoryInstallmentCount" class="java.lang.Integer"/>
    <field name="cycleFeeCount" class="java.lang.Integer"/>
    <field name="cycleTotalAmountLabel" class="java.lang.String"/>
    <field name="trancheFeeCount" class="java.lang.Integer"/>
    <field name="trancheTotalAmountLabel" class="java.lang.String"/>

    <group name="FeeCategoryGroup">
        <groupExpression><![CDATA[$F{feeCategoryName}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <rectangle radius="3">
                    <reportElement x="0" y="2" width="802" height="16" mode="Opaque" backcolor="#D6E8F7"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#7EB0E8"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="GroupCategory" x="10" y="4" width="480" height="12"/>
                    <textFieldExpression><![CDATA["CATÉGORIE : " + ($F{feeCategoryName} != null ? $F{feeCategoryName}.toUpperCase() : "")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="500" y="4" width="140" height="12"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Frais : " + $F{categoryFeeCount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="650" y="4" width="140" height="12"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total : " + $F{categoryTotalAmountLabel}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="16">
                <rectangle radius="2">
                    <reportElement x="0" y="1" width="802" height="13" mode="Opaque" backcolor="#EEF4FB"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#C5D7EC"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="TableCell" x="8" y="2" width="300" height="11" forecolor="#0B2447"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="7" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["TOTAL " + ($F{feeCategoryName} != null ? $F{feeCategoryName}.toUpperCase() : "")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="400" y="2" width="110" height="11" forecolor="#0B2447"/>
                    <textElement textAlignment="Right">
                        <font fontName="DejaVu Sans" size="7" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{categoryTotalAmountLabel}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="520" y="2" width="80" height="11" forecolor="#0B2447"/>
                    <textElement textAlignment="Center">
                        <font fontName="DejaVu Sans" size="7" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{categoryInstallmentCount} + " tranche(s)"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <group name="CycleGroup">
        <groupExpression><![CDATA[$F{feeCategoryName} + "|" + $F{cycleDisplayOrder} + "|" + $F{cycleName}]]></groupExpression>
        <groupHeader>
            <band height="18">
                <rectangle radius="3">
                    <reportElement x="0" y="1" width="802" height="15" mode="Opaque" backcolor="#E8F5E9"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#81C784"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="GroupCycle" x="16" y="3" width="460" height="11"/>
                    <textFieldExpression><![CDATA["CYCLE : " + $F{cycleName}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="500" y="3" width="140" height="11"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Frais : " + $F{cycleFeeCount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="650" y="3" width="140" height="11"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total : " + $F{cycleTotalAmountLabel}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="14">
                <rectangle radius="2">
                    <reportElement x="0" y="1" width="802" height="11" mode="Opaque" backcolor="#F1F8F2"/>
                    <graphicElement>
                        <pen lineWidth="0.4" lineColor="#C8E6C9"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="TableCell" x="16" y="1" width="300" height="10" forecolor="#1B5E20"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="6" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Sous-total cycle : " + $F{cycleName}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="400" y="1" width="110" height="10" forecolor="#1B5E20"/>
                    <textElement textAlignment="Right">
                        <font fontName="DejaVu Sans" size="6" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{cycleTotalAmountLabel}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <group name="TrancheGroup">
        <groupExpression><![CDATA[$F{feeCategoryName} + "|" + $F{cycleDisplayOrder} + "|" + $F{cycleName} + "|" + $F{installmentDisplayOrder} + "|" + $F{installmentName}]]></groupExpression>
        <groupHeader>
            <band height="16">
                <rectangle radius="2">
                    <reportElement x="0" y="1" width="802" height="13" mode="Opaque" backcolor="#FFF8E1"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#FFE082"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="GroupTranche" x="24" y="2" width="450" height="11"/>
                    <textFieldExpression><![CDATA["TRANCHE : " + $F{installmentName}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="500" y="2" width="140" height="11"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Frais : " + $F{trancheFeeCount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="650" y="2" width="140" height="11"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total : " + $F{trancheTotalAmountLabel}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="12">
                <rectangle radius="2">
                    <reportElement x="0" y="0" width="802" height="10" mode="Opaque" backcolor="#FFFDE7"/>
                    <graphicElement>
                        <pen lineWidth="0.3" lineColor="#FFF59D"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement style="TableCell" x="24" y="0" width="300" height="10" forecolor="#5D4037"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="6" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Sous-total tranche : " + $F{installmentName}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="TableCell" x="400" y="0" width="110" height="10" forecolor="#5D4037"/>
                    <textElement textAlignment="Right">
                        <font fontName="DejaVu Sans" size="6" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{trancheTotalAmountLabel}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="188">
            <rectangle radius="6">
                <reportElement x="0" y="0" width="802" height="108" mode="Opaque" backcolor="#FAFCFF"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#A8C4E8"/>
                </graphicElement>
            </rectangle>

            <image onErrorType="Blank" scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
                <reportElement x="12" y="12" width="64" height="64"/>
                <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="84" y="12" width="180" height="12" forecolor="#1E88E5"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ECLOSIA Gestion Scolaire]]></text>
            </staticText>
            <textField>
                <reportElement x="84" y="24" width="280" height="18" forecolor="#0B2447"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_NAME} != null ? $P{SCHOOL_NAME}.toUpperCase() : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="84" y="44" width="280" height="12" forecolor="#4A5568"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="84" y="56" width="280" height="12" forecolor="#4A5568"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Tél : " + $P{SCHOOL_PHONE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="84" y="68" width="280" height="12" forecolor="#4A5568"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Email : " + $P{SCHOOL_EMAIL}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="280" y="16" width="260" height="20" forecolor="#0B2447"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[ÉTAT DES FRAIS CONFIGURÉS]]></text>
            </staticText>
            <textField>
                <reportElement x="280" y="40" width="260" height="14" forecolor="#1A56A8"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Année scolaire : " + $P{ACADEMIC_YEAR_LABEL}]]></textFieldExpression>
            </textField>

            <rectangle radius="6">
                <reportElement x="560" y="10" width="230" height="92" mode="Opaque" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#A8C4E8"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="16" width="70" height="10"/>
                <text><![CDATA[Période :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="16" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{PERIOD_LABEL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="28" width="70" height="10"/>
                <text><![CDATA[Cycle :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="28" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{CYCLE_FILTER_LABEL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="40" width="70" height="10"/>
                <text><![CDATA[Classe :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="40" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{CLASS_FILTER_LABEL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="52" width="70" height="10"/>
                <text><![CDATA[Mode paiement :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="52" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{PAYMENT_MODE_FILTER_LABEL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="64" width="70" height="10"/>
                <text><![CDATA[Devise :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="64" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{CURRENCY_FILTER_LABEL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="FilterLabel" x="570" y="76" width="70" height="10"/>
                <text><![CDATA[Imprimé le :]]></text>
            </staticText>
            <textField>
                <reportElement style="FilterValue" x="640" y="76" width="140" height="10"/>
                <textFieldExpression><![CDATA[$P{PRINT_DATETIME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="114" width="200" height="12" forecolor="#1A56A8"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[RÉCAPITULATIF GÉNÉRAL]]></text>
            </staticText>

            <rectangle radius="4">
                <reportElement x="0" y="128" width="190" height="52" mode="Opaque" backcolor="#F7FAFF"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#90CAF9"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiLabel" x="10" y="134" width="170" height="10"/>
                <text><![CDATA[Nombre total de frais]]></text>
            </staticText>
            <textField>
                <reportElement style="KpiValue" x="10" y="150" width="170" height="16"/>
                <textFieldExpression><![CDATA[String.valueOf($P{TOTAL_FEES_COUNT})]]></textFieldExpression>
            </textField>

            <rectangle radius="4">
                <reportElement x="204" y="128" width="190" height="52" mode="Opaque" backcolor="#F3FFF6"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#81C784"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiLabel" x="214" y="134" width="170" height="10"/>
                <text><![CDATA[Montant total annuel attendu]]></text>
            </staticText>
            <textField>
                <reportElement x="214" y="150" width="170" height="16" forecolor="#2E7D32"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_ANNUAL_AMOUNT_LABEL}]]></textFieldExpression>
            </textField>

            <rectangle radius="4">
                <reportElement x="408" y="128" width="190" height="52" mode="Opaque" backcolor="#F8F4FF"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#CE93D8"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiLabel" x="418" y="134" width="170" height="10"/>
                <text><![CDATA[Nombre total de tranches]]></text>
            </staticText>
            <textField>
                <reportElement x="418" y="150" width="170" height="16" forecolor="#7B1FA2"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[String.valueOf($P{TOTAL_INSTALLMENTS_COUNT})]]></textFieldExpression>
            </textField>

            <rectangle radius="4">
                <reportElement x="612" y="128" width="190" height="52" mode="Opaque" backcolor="#FFF8F0"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#FFB74D"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="KpiLabel" x="622" y="134" width="170" height="10"/>
                <text><![CDATA[Nombre de catégories]]></text>
            </staticText>
            <textField>
                <reportElement x="622" y="150" width="170" height="16" forecolor="#EF6C00"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[String.valueOf($P{TOTAL_CATEGORIES_COUNT})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle radius="3">
                <reportElement x="0" y="2" width="802" height="16" mode="Opaque" backcolor="#1565C0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="TableHeader" x="2" y="4" width="22" height="12"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[N°]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="24" y="4" width="70" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <text><![CDATA[Code]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="94" y="4" width="120" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <text><![CDATA[Libellé du frais]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="214" y="4" width="90" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <text><![CDATA[Catégorie]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="304" y="4" width="120" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <text><![CDATA[Applicable à]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="424" y="4" width="95" height="12"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Montant annuel]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="519" y="4" width="50" height="12"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Tranches]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="569" y="4" width="70" height="12"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Périodicité]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="639" y="4" width="75" height="12"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Mode calcul]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="714" y="4" width="84" height="12"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Statut]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="17" mode="Transparent"/>
                <graphicElement>
                    <pen lineWidth="0.4" lineColor="#E3EAF3"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement style="TableCell" x="2" y="3" width="22" height="12"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{rowNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="24" y="3" width="70" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{code}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="94" y="3" width="120" height="12"/>
                <textElement>
                    <paragraph leftIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{feeName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="214" y="3" width="90" height="12"/>
                <textElement>

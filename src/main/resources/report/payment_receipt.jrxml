        </band>
    </title>

    <pageHeader>
        <band height="180">
            <!-- INFORMATIONS ÉLÈVE -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="270" height="170" mode="Opaque" backcolor="#FFFFFF"/>

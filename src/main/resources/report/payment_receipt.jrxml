            <staticText>
                <reportElement x="321" y="12" width="220" height="14" forecolor="#1A56A8"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[INFORMATIONS PAIEMENT]]></text>
            </staticText>

            <staticText><reportElement style="Label" x="300" y="38" width="110" height="14"/><text><![CDATA[Mode de paiement :]]></text></staticText>
            <textField><reportElement style="Value" x="412" y="38" width="130" height="14"/><textFieldExpression><![CDATA[$P{PAYMENT_METHOD}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="300" y="54" width="110" height="14"/><text><![CDATA[Référence transaction :]]></text></staticText>
            <textField><reportElement style="Value" x="412" y="54" width="130" height="14"/><textFieldExpression><![CDATA[$P{TRANSACTION_REFERENCE}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="300" y="70" width="110" height="14"/><text><![CDATA[Opérateur :]]></text></staticText>

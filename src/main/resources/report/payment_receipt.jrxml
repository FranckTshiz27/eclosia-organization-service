            <staticText><reportElement style="Label" x="300" y="86" width="110" height="14"/><text><![CDATA[Numéro expéditeur :]]></text></staticText>
            <textField><reportElement style="Value" x="412" y="86" width="130" height="14"/><textFieldExpression><![CDATA[$P{SENDER_PHONE}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="300" y="102" width="110" height="14"/><text><![CDATA[Devise :]]></text></staticText>
            <textField><reportElement style="Value" x="412" y="102" width="130" height="14"/><textFieldExpression><![CDATA[$P{CURRENCY_LABEL}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="300" y="118" width="110" height="14"/><text><![CDATA[Taux de change :]]></text></staticText>

            <line><reportElement x="28" y="18" width="1" height="24"/><graphicElement><pen lineWidth="0.5" lineColor="#FFFFFF"/></graphicElement></line>
            <line><reportElement x="196" y="18" width="1" height="24"/><graphicElement><pen lineWidth="0.5" lineColor="#FFFFFF"/></graphicElement></line>

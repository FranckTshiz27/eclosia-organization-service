<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payment_receipt"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="18"
              bottomMargin="18"
              whenNoDataType="AllSectionsNoDetail">

    <style name="Label" fontName="DejaVu Sans" fontSize="8" forecolor="#5F6B7A"/>
    <style name="Value" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#0B2447"/>
    <style name="SectionTitle" fontName="DejaVu Sans" fontSize="9" isBold="true" forecolor="#1A56A8"/>

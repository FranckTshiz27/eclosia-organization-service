    <summary>
        <band height="250">
            <rectangle radius="4">
                <reportElement x="0" y="0" width="555" height="26" mode="Opaque" backcolor="#E3EEF9"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#A8C4E8"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="6" width="220" height="14" forecolor="#1A56A8"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL PAYÉ]]></text>
            </staticText>
            <textField>

            <textField><reportElement style="Value" x="412" y="134" width="130" height="14"/><textFieldExpression><![CDATA[$P{PAYMENT_DATE}]]></textFieldExpression></textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="48">
            <staticText>
                <reportElement x="0" y="0" width="555" height="14" forecolor="#1A56A8"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[DÉTAIL DES FRAIS PAYÉS]]></text>

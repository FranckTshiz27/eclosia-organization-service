    <detail>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="22" mode="Opaque" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="0" width="555" height="22" mode="Opaque" backcolor="#F2F6FB">
                    <printWhenExpression><![CDATA[$V{ROW_INDEX} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line>
                <reportElement x="0" y="21" width="555" height="1"/>

            <textField><reportElement style="TableCell" x="32" y="4" width="158" height="14"/><textElement><paragraph leftIndent="4" rightIndent="4"/></textElement><textFieldExpression><![CDATA[$F{feeLabel}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="200" y="4" width="98" height="14"/><textElement><paragraph leftIndent="4" rightIndent="4"/></textElement><textFieldExpression><![CDATA[$F{periodDetail}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="308" y="4" width="70" height="14"/><textElement textAlignment="Right"><paragraph leftIndent="4" rightIndent="4"/></textElement><textFieldExpression><![CDATA[$F{unitAmount}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="390" y="4" width="24" height="14"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement style="AmountGreen" x="424" y="4" width="122" height="14"/><textElement textAlignment="Right"><paragraph leftIndent="4" rightIndent="4"/></textElement><textFieldExpression><![CDATA[$F{paidAmount}]]></textFieldExpression></textField>

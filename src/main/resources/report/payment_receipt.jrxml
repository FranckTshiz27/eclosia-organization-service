    <style name="TableCell" fontName="DejaVu Sans" fontSize="8" forecolor="#243447"/>
    <style name="AmountGreen" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#2E7D32"/>
    <style name="AmountRed" fontName="DejaVu Sans" fontSize="8" isBold="true" forecolor="#D32F2F"/>

    <parameter name="LOGO_IMAGE" class="java.lang.Object"/>
    <parameter name="SCHOOL_NAME" class="java.lang.String"/>
    <parameter name="SCHOOL_MOTTO" class="java.lang.String"/>
    <parameter name="SCHOOL_ADDRESS" class="java.lang.String"/>
    <parameter name="SCHOOL_PHONE" class="java.lang.String"/>
    <parameter name="SCHOOL_EMAIL" class="java.lang.String"/>
    <parameter name="SCHOOL_WEBSITE" class="java.lang.String"/>
    <parameter name="RECEIPT_NUMBER" class="java.lang.String"/>
    <parameter name="RECEIPT_BARCODE" class="java.lang.String"/>
    <parameter name="ISSUE_DATE" class="java.lang.String"/>
    <parameter name="ISSUE_TIME" class="java.lang.String"/>
    <parameter name="PRINT_DATETIME" class="java.lang.String"/>
    <parameter name="STUDENT_FULL_NAME" class="java.lang.String"/>
    <parameter name="STUDENT_NUMBER" class="java.lang.String"/>
    <parameter name="CLASSROOM_NAME" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR_LABEL" class="java.lang.String"/>
    <parameter name="STUDENT_CATEGORY" class="java.lang.String"/>
    <parameter name="GUARDIAN_PHONE" class="java.lang.String"/>
    <parameter name="PHOTO_IMAGE" class="java.lang.Object"/>
    <parameter name="PAYMENT_METHOD" class="java.lang.String"/>
    <parameter name="PAYMENT_OPERATOR" class="java.lang.String"/>
    <parameter name="TRANSACTION_REFERENCE" class="java.lang.String"/>
    <parameter name="REFERENCE_NUMBER" class="java.lang.String"/>
    <parameter name="SENDER_PHONE" class="java.lang.String"/>
    <parameter name="CURRENCY_LABEL" class="java.lang.String"/>
    <parameter name="CURRENCY_CODE" class="java.lang.String"/>
    <parameter name="EXCHANGE_RATE_LABEL" class="java.lang.String"/>
    <parameter name="PAYMENT_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_FEES" class="java.lang.String"/>
    <parameter name="TOTAL_PAID" class="java.lang.String"/>
    <parameter name="REMAINING_BALANCE" class="java.lang.String"/>
    <parameter name="TOTAL_PAID_WORDS" class="java.lang.String"/>
    <parameter name="PREPARED_BY" class="java.lang.String"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="feeLabel" class="java.lang.String"/>
    <field name="periodDetail" class="java.lang.String"/>
    <field name="unitAmount" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="paidAmount" class="java.lang.String"/>

    <variable name="ROW_INDEX" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <title>
        <band height="168">
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="158" mode="Opaque" backcolor="#FAFCFF"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#A8C4E8"/></graphicElement>
            </rectangle>

            <image onErrorType="Blank" scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
                <reportElement x="12" y="12" width="78" height="62"/>
                <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="98" y="12" width="220" height="13" forecolor="#1E88E5"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[ECLOSIA Gestion Scolaire]]></text>
            </staticText>
            <textField>
                <reportElement x="98" y="26" width="260" height="18" forecolor="#0B2447"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_NAME}.toUpperCase()]]></textFieldExpression>
            </textField>
            <textField>

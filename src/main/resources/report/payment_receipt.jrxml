            <textField><reportElement style="Value" x="176" y="114" width="85" height="14"/><textFieldExpression><![CDATA[$P{ACADEMIC_YEAR_LABEL}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="96" y="130" width="78" height="14"/><text><![CDATA[Téléphone parent :]]></text></staticText>
            <textField><reportElement style="Value" x="176" y="130" width="85" height="14"/><textFieldExpression><![CDATA[$P{GUARDIAN_PHONE}]]></textFieldExpression></textField>

            <!-- INFORMATIONS PAIEMENT -->
            <rectangle radius="8">
                <reportElement x="285" y="0" width="270" height="170" mode="Opaque" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.2" lineColor="#7EB0E8"/></graphicElement>
            </rectangle>
            <ellipse>
                <reportElement x="297" y="10" width="18" height="18" mode="Opaque" backcolor="#2E7D32"/>

            <textField>
                <reportElement x="110" y="84" width="248" height="11" forecolor="#4A5568"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_EMAIL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="98" y="96" width="12" height="11" forecolor="#1E88E5"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <text><![CDATA[◉]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="96" width="248" height="11" forecolor="#4A5568"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{SCHOOL_WEBSITE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="360" y="10" width="185" height="20" forecolor="#0B2447"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="15" isBold="true"/></textElement>
                <text><![CDATA[REÇU DE PAIEMENT]]></text>
            </staticText>
            <rectangle radius="6">
                <reportElement x="360" y="34" width="185" height="26" mode="Opaque" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.0" lineColor="#A8C4E8"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="365" y="41" width="175" height="14" forecolor="#D32F2F"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["N° " + $P{RECEIPT_NUMBER}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="360" y="66" width="12" height="11" forecolor="#1E88E5"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <text><![CDATA[▣]]></text>
            </staticText>
            <textField>
                <reportElement x="372" y="66" width="173" height="11" forecolor="#4A5568"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Date d'émission : " + $P{ISSUE_DATE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="360" y="78" width="12" height="11" forecolor="#1E88E5"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <text><![CDATA[◷]]></text>
            </staticText>
            <textField>
                <reportElement x="372" y="78" width="173" height="11" forecolor="#4A5568"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Heure : " + $P{ISSUE_TIME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="360" y="90" width="12" height="11" forecolor="#1E88E5"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <text><![CDATA[⎙]]></text>
            </staticText>
            <textField>
                <reportElement x="372" y="90" width="173" height="11" forecolor="#4A5568"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le : " + $P{PRINT_DATETIME}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="430" y="108" width="115" height="38" mode="Opaque" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#C5D9F2" lineStyle="Dashed"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="430" y="118" width="115" height="18" forecolor="#243447"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RECEIPT_BARCODE}]]></textFieldExpression>

            <staticText>
                <reportElement x="36" y="12" width="220" height="14" forecolor="#1A56A8"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[INFORMATIONS ÉLÈVE]]></text>
            </staticText>

            <image onErrorType="Blank" scaleImage="FillFrame" hAlign="Center" vAlign="Middle">
                <reportElement x="14" y="34" width="72" height="72"/>
                <imageExpression><![CDATA[$P{PHOTO_IMAGE}]]></imageExpression>
            </image>
            <ellipse>
                <reportElement x="14" y="34" width="72" height="72" mode="Transparent">
                    <printWhenExpression><![CDATA[$P{PHOTO_IMAGE} == null]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#7EB0E8"/></graphicElement>
            </ellipse>
            <staticText>
                <reportElement x="14" y="56" width="72" height="24" forecolor="#A8C4E8">
                    <printWhenExpression><![CDATA[$P{PHOTO_IMAGE} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="16"/></textElement>
                <text><![CDATA[👤]]></text>
            </staticText>
            <ellipse>
                <reportElement x="14" y="34" width="72" height="72" mode="Transparent">
                    <printWhenExpression><![CDATA[$P{PHOTO_IMAGE} != null]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#7EB0E8"/></graphicElement>
            </ellipse>

            <staticText><reportElement style="Label" x="96" y="34" width="165" height="12"/><text><![CDATA[Nom complet :]]></text></staticText>
            <textField textAdjust="StretchHeight" isStretchWithOverflow="true">
                <reportElement style="Value" x="96" y="48" width="165" height="14"/>
                <textFieldExpression><![CDATA[$P{STUDENT_FULL_NAME}]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="96" y="66" width="78" height="14"/><text><![CDATA[Matricule :]]></text></staticText>
            <textField><reportElement style="Value" x="176" y="66" width="85" height="14"/><textFieldExpression><![CDATA[$P{STUDENT_NUMBER}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="96" y="82" width="78" height="14"/><text><![CDATA[Classe :]]></text></staticText>
            <textField><reportElement style="Value" x="176" y="82" width="85" height="14"/><textFieldExpression><![CDATA[$P{CLASSROOM_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="96" y="98" width="78" height="14"/><text><![CDATA[Catégorie :]]></text></staticText>
            <textField><reportElement style="Value" x="176" y="98" width="85" height="14"/><textFieldExpression><![CDATA[$P{STUDENT_CATEGORY}]]></textFieldExpression></textField>
